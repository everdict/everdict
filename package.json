{
  "name": "everdict",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "cone": "node scripts/check-job-runner-cone.mjs",
    "web-imports": "node scripts/check-web-imports.mjs",
    "web-reach": "node scripts/check-web-reach.mjs",
    "migrations": "node scripts/check-migrations.mjs",
    "artifact-frame": "node scripts/check-artifact-frame.mjs",
    "convention-harness": "node scripts/check-convention-harness.mjs",
    "authz-optional": "node scripts/check-authz-optional.mjs",
    "import-cycles": "node scripts/check-import-cycles.mjs",
    "protocol-mutations": "node scripts/trust/protocol-mutations.mjs",
    "plugin-manifests": "node scripts/check-plugin-manifests.mjs",
    "docs-check": "node scripts/check-docs.mjs",
    "intent-chain": "node scripts/check-intent-chain.mjs",
    "guardrails": "node scripts/check-guardrails.mjs",
    "scanner-watches": "node scripts/check-scanner-watches.mjs",
    "design": "node scripts/design/run.mjs",
    "review": "node scripts/review/run.mjs",
    "watch-bands": "node scripts/bands/watch.mjs",
    "triage": "node scripts/triage.mjs",
    "scan": "node scripts/scan/run.mjs",
    "controls-documented": "node scripts/check-controls-documented.mjs",
    "lesson-evals": "node scripts/check-lesson-evals.mjs",
    "telemetry": "node scripts/telemetry/otlp-sink.mjs",
    "agent-evals": "node evals/run.mjs",
    "constructed-casts": "node scripts/check-constructed-casts.mjs",
    "guarded-doubles": "node scripts/check-guarded-doubles.mjs",
    "unwired-capabilities": "node scripts/check-unwired-capabilities.mjs",
    "gated-doors": "node scripts/check-gated-doors.mjs",
    "unwired-guards": "node scripts/check-unwired-guards.mjs",
    "option-forwarding": "node scripts/check-option-forwarding.mjs",
    "ci:commits": "node scripts/ci-commits.mjs",
    "language-policy": "node scripts/check-language-policy.mjs",
    "guard-siblings": "node scripts/check-guard-siblings.mjs",
    "source-bytes": "node scripts/check-source-bytes.mjs",
    "untrusted-ingress": "node scripts/check-untrusted-ingress.mjs",
    "mutation-leak": "node scripts/check-mutation-leak.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "everdict": "node --env-file-if-exists=.env apps/cli/dist/main.js",
    "api": "node --env-file-if-exists=apps/api/.env apps/api/dist/main.js",
    "api:dev": "node --watch --env-file-if-exists=apps/api/.env apps/api/dist/main.js",
    "api:start": "pnpm build && pnpm api",
    "keycloak": "KEYCLOAK_PORT=${KEYCLOAK_PORT:-8081} docker compose -f deploy/keycloak/docker-compose.yaml up -d",
    "keycloak:down": "docker compose -f deploy/keycloak/docker-compose.yaml down",
    "keycloak:reset": "docker compose -f deploy/keycloak/docker-compose.yaml down -v",
    "keycloak:logs": "docker compose -f deploy/keycloak/docker-compose.yaml logs -f keycloak"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
