# env for deploy/compose/docker-compose.prod.yaml. Copy it to .env:
#   cp deploy/compose/.env.example deploy/compose/.env
# (the dev compose needs almost no values — a token only when actually running the claude-code harness)
#
# Prebuilt image tags pulled from GHCR (api/web/agent). Default to latest; pin a release e.g. 0.1.0.
# Ignored when you run `up --build` (builds from source instead).
# Each service is released on its own tag (`api-v1.2.0` → everdict-api:1.2.0), so each one pins separately;
# EVERDICT_VERSION is what an unset service falls back to.
EVERDICT_VERSION=
EVERDICT_API_VERSION=
EVERDICT_WEB_VERSION=
EVERDICT_AGENT_VERSION=
#
# Keycloak-less setup: the web operates as tenant=default and the API does not enforce auth. Assumes a trusted network.

# ── Ports ─────────────────────────────────────────────────────
WEB_PORT=3001
API_PORT=8787
AGENT_PORT=8790

# ── Postgres (required: password) ─────────────────────────────
POSTGRES_USER=everdict
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=everdict

# ── Control-plane API (optional) ──────────────────────────────
# Secret at-rest encryption KEK (base64, 32 bytes): openssl rand -base64 32. Leave empty to disable the secret store.
EVERDICT_SECRETS_KEY=
# Guard token for internal routes (/internal/**, minting tenant API keys): openssl rand -hex 32. Leave empty to disable those routes.
EVERDICT_INTERNAL_TOKEN=
# Per-tenant concurrent-run ceiling (optional). Leave empty for unlimited.
EVERDICT_TENANT_RUNS=

# ── Trace ledger (the OWNED trajectory store) ──────────────────
# Everdict keeps its own copy of every trace it stands on — eval runs, AGENT conversation turns (a transcript is a
# trace), OTLP-door arrivals (POST /v1/traces), materialized pull-imports. Browse it in Settings › Traces.
# Empty = the ledger lives in the Postgres above (enough for eval-scale). For ops-scale volume point it at an
# EXTERNAL ClickHouse — this stack bundles no engine (docker-compose.full.yaml has one behind `--profile clickhouse`).
# ⚠️ Switching engines is not a migration: what is already sealed stays where it was written.
EVERDICT_CLICKHOUSE_URL=
EVERDICT_CLICKHOUSE_DATABASE=
# OTLP-door admission: events per workspace per rolling hour (empty = unlimited). Past it the door 429s and lands
# trace.ingestion_throttled on the event log. A workspace may set a lower limit for itself, never a higher one.
EVERDICT_INGEST_MAX_EVENTS_PER_HOUR=
# Ledger retention in days (empty = keep forever). A daily sweep deletes trajectories sealed before the cutoff.
EVERDICT_TRAJECTORY_RETENTION_DAYS=

# ── Workspace GitHub App integration (github.com; org install → selected repos) ────────
# Everdict GitHub **App** credentials for github.com. Create at: https://github.com/settings/apps → New GitHub App.
#   Setup URL = ${API_PUBLIC_URL}/workspace/github-app/callback. Permissions: Contents·Pull requests·Administration.
# (GHE needs no env — an admin registers it per workspace under Settings › Integrations)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=  # App private key (PEM); base64(PEM) recommended for single-line env-file safety
GITHUB_APP_SLUG=  # used in the install URL github.com/apps/<slug>/installations/new
# The externally reachable API base — the App install callback (Setup URL) base + the Mattermost inbound URL.
# ⚠️ On a new host, use this machine's real reachable host, not localhost. Leave empty to fall back to the request host (dev).
#   e.g. API_PUBLIC_URL=http://<your-host>:8787
API_PUBLIC_URL=
# The web base the browser is sent back to after the callback. Leave empty for http://localhost:3001 (dev default) → on an external host this jumps to the wrong place.
#   e.g. WEB_BASE_URL=http://<your-host>:3001
WEB_BASE_URL=

# ── Local backend run auth (optional) ─────────────────────────
# Only when LocalBackend runs the claude-code harness in-process. Can be replaced by the tenant SecretStore.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# ── Conversational agent (the assistant behind the web chat + teammates) ───────────────
# The agent needs a model to answer. Set EXACTLY ONE; with neither, the agent container fails fast on boot
# (web/api still come up — only the chat is down).
#   A) AGENT_MODEL   — a registered workspace model id (needs EVERDICT_SECRETS_KEY to decrypt its provider key).
#   B) AGENT_LLM_*   — a raw OpenAI-compatible endpoint (LiteLLM / vLLM; host proxy → host.docker.internal).
AGENT_MODEL=
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
# Proactive teammates (S4): the api pushes completions to the agent to wake watching teammates. Must match on both
# services (injected into api AND agent). Empty → disabled (chat still works). openssl rand -hex 32
AGENT_INTERNAL_TOKEN=
# Optional: let the agent DRIVE eval (HITL/RBAC-gated) + built-in web_search (Tavily) out of the box.
AGENT_ALLOW_EVAL_DRIVE=
AGENT_WEBSEARCH_API_KEY=
