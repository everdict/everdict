{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-verify-multirunner/types/**/*.ts",
    ".next-verify-multirunner/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-dev-claude/types/**/*.ts",
    ".next-dev-claude/dev/types/**/*.ts",
    ".next-verify-store/types/**/*.ts",
    ".next-verify-store/dev/types/**/*.ts",
    ".next-live/types/**/*.ts",
    ".next-live/dev/types/**/*.ts",
    ".next-dev-store/types/**/*.ts",
    ".next-dev-store/dev/types/**/*.ts",
    ".next-dev-verify/types/**/*.ts",
    ".next-dev-verify/dev/types/**/*.ts",
    ".next-verify-nav/types/**/*.ts",
    ".next-verify-nav/dev/types/**/*.ts",
    ".next-dev-drill/types/**/*.ts",
    ".next-dev-drill/dev/types/**/*.ts",
    ".next-drill/types/**/*.ts",
    ".next-drill/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
