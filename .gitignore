node_modules/
dist/
.turbo/
coverage/

# env / secrets — never commit (no secret in git)
.env
.env.*
!.env.example
!.env.*.example
*.local
*.pem
*_credentials

# editor / os
.DS_Store
*.log

# live e2e artifacts (screenshots etc. that scripts/live/*.mjs write to the repo root — not meant to be committed)
/e2e-*.png

# electron packaging artifacts (apps/desktop)
apps/desktop/bundle/
apps/desktop/release/

# alternate Next dist dirs (NEXT_DIST_DIR — a dev server running beside another one). apps/web/.gitignore only
# covers the default `.next`, and an UNIGNORED dist dir is not merely untracked noise: Tailwind's source detection
# honours .gitignore, so it would scan the build output and mine its binary chunks for class candidates, emitting
# CSS with control bytes in it ("Parsing CSS source code failed").
apps/web/.next-*/

# standalone runner bundle / SEA binaries (apps/cli — `pnpm bundle` + release CI)
apps/cli/bundle/

# python bytecode
__pycache__/
*.pyc

# managed image store signing material (deploy/compose/full.sh --profile images generates it locally).
# A private key in git is a real secret, not a fixture — the gitleaks gate would be right to stop it.
deploy/compose/certs/
